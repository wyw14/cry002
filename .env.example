APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://archive:archive@localhost:5432/archive?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TTL=15m
REFRESH_TTL=168h
REQUEST_TIMEOUT=8s
ALLOW_IN_MEMORY=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
LOG_LEVEL=info
